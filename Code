            return "Hard", 1, 10

        else:
            print("❌ Please choose 1, 2, or 3.")


# ============================================================
#                    PLAY GAME ROUND
# ============================================================

def play_round(difficulty, attempts, time_limit):

    word = random.choice(WORDS)

    shift = random.randint(1, 25)

    encrypted_word = caesar_cipher(word, shift)

    print("\n" + "=" * 50)
    print("                   NEW ROUND")
    print("=" * 50)

    print(f"\nDifficulty : {difficulty}")
    print(f"Encrypted : {encrypted_word}")
    print(f"Shift     : {shift}")
    print(f"Attempts  : {attempts}")
    print(f"Time      : {time_limit} seconds")

    print("\nDecode the encrypted word!")

    start_time = time.time()

    for attempt in range(1, attempts + 1):

        elapsed = time.time() - start_time

        if elapsed >= time_limit:

            print("\n⏰ TIME'S UP!")
            print(f"The correct word was: {word}")

            return 0

        print(f"\nAttempt {attempt}/{attempts}")

        guess = input("Your answer: ").strip().lower()

        # Check timer after input
        elapsed = time.time() - start_time

        if elapsed >= time_limit:

            print("\n⏰ TIME'S UP!")
            print(f"The correct word was: {word}")

            return 0

        if guess == word:

            points = 10

            # First-attempt bonus
            if attempt == 1:
                points += 5

            # Time bonus
            if elapsed <= time_limit / 2:
                points += 5

            print("\n🎉 CORRECT!")
            print(f"The word was: {word}")
            print(f"Time: {elapsed:.2f} seconds")
            print(f"Points earned: {points}")

            return points

        else:

            if attempt < attempts:
                print("❌ Incorrect! Try again.")

            else:
                print("\n❌ No attempts remaining.")
                print(f"The correct word was: {word}")

    return 0


# ============================================================
#                    START GAME
# ============================================================

def start_game():

    print("\n" + "=" * 55)
    print("             🔐 CAESAR CIPHER CHALLENGE")
    print("=" * 55)

    print("""
Decode the encrypted word using the Caesar Cipher.

You will receive:
• An encrypted word
• A shift value
• A limited number of attempts
• A time limit

Good luck!
""")

    difficulty, attempts, time_limit = choose_difficulty()

    score = 0
    rounds = 0

    while True:

        rounds += 1

        points = play_round(
            difficulty,
            attempts,
            time_limit
        )

        score += points

        print("\n" + "-" * 50)
        print(f"Current score: {score}")
        print("-" * 50)

        choice = input(
            "\nPlay another round? (y/n): "
        ).strip().lower()

        if choice != "y":
            break

    print("\n" + "=" * 50)
    print("                 GAME OVER")
    print("=" * 50)

    print(f"Rounds played : {rounds}")
    print(f"Final score   : {score}")

    if score >= rounds * 15:
        print("🏆 Excellent performance!")

    elif score >= rounds * 10:
        print("👏 Great job!")

    elif score > 0:
        print("👍 Good effort!")

    else:
        print("Keep practicing!")

    print("=" * 50)


