# ============================================================
#                  CAESAR CIPHER FUNCTION
# ============================================================

def caesar_cipher(text, shift):
    result = ""

    for char in text:

        if char.isalpha():

            if char.isupper():
                base = ord("A")
            else:
                base = ord("a")

            new_char = chr(
                (ord(char) - base + shift) % 26 + base
            )

            result += new_char

        else:
            # Keep spaces, numbers, and symbols unchanged
            result += char

    return result


# ============================================================
#                    ENCRYPT MESSAGE
# ============================================================

def encrypt_message():

    print("\n" + "=" * 50)
    print("                 ENCRYPT MESSAGE")
    print("=" * 50)

    text = input("\nEnter your message: ")

    shift = get_shift()

    encrypted = caesar_cipher(text, shift)

    print("\n🔐 Encrypted message:")
    print(encrypted)


# ============================================================
#                    DECRYPT MESSAGE
# ============================================================

def decrypt_message():

    print("\n" + "=" * 50)
    print("                 DECRYPT MESSAGE")
    print("=" * 50)

    text = input("\nEnter the encrypted message: ")

    shift = get_shift()

    decrypted = caesar_cipher(text, -shift)

    print("\n🔓 Decrypted message:")
    print(decrypted)


# ============================================================
#                    GET SHIFT VALUE
# ============================================================

def get_shift():

    while True:

        try:
            shift = int(
                input("Enter shift value (1-25): ")
            )

            if 1 <= shift <= 25:
                return shift

            print("❌ Shift must be between 1 and 25.")

        except ValueError:
            print("❌ Please enter a valid number.")


